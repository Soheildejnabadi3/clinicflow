## ---------------------------------------------------------------------------
## Secrets and local configuration -- keep this block first and never relax it.
## ---------------------------------------------------------------------------
# Environment files
.env
.env.*
!.env.example

# Machine- or environment-specific settings. appsettings.json and
# appsettings.Development.json ARE committed (see README) because they hold only
# a throwaway localhost sandbox credential; anything below must never be.
appsettings.Production.json
appsettings.Local.json
appsettings.*.local.json
secrets.json

# Certificates and keys
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer
*.jks
*.keystore

